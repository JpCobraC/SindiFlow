# SindiFlow — variáveis públicas lidas em tempo de build pelo Expo.
# Copie para `.env` e preencha com os valores do projeto Supabase e do
# Google Cloud Console. `.env` não é versionado.
#
# Sem essas variáveis, o app boota em desenvolvimento com placeholders e
# avisa no console; em produção o boot falha com ConfiguracaoAusenteError.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=SUA_ANON_KEY
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=SEU_WEB_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=SEU_IOS_CLIENT_ID.apps.googleusercontent.com
